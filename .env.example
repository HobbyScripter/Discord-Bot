# Discord
DISCORD_TOKEN=your_bot_token
DISCORD_GUILD_ID=
# Optional. Empty = all communities the bot can access.

# GitHub
GITHUB_OWNER=YourEliteSystems
GITHUB_REPO=WebRadio
# Optional: increases GitHub API rate limit for the bot.
# GITHUB_TOKEN=github_token

# GitHub polling interval. Minimum 60000 ms. Default: 300000 (5 minutes)
GITHUB_POLL_INTERVAL_MS=300000

# Welcome Messages
WELCOME_CHANNEL_NAME=📜・welcome
WELCOME_MENTION=true
WELCOME_INCLUDE_BOTS=false
# Optional: JSON array with custom welcome templates. Available tokens:
# {user} {username} {mention} {server} {memberCount} {rules} {roles} {github}
# Example:
# WELCOME_MESSAGES_JSON=[{"title":"👋 Willkommen bei WebRadio, {username}!","description":"Schön, dass du da bist, {mention}! Schau gerne bei {roles} vorbei.","color":5793266}]

# Local dashboard (secure default: loopback only)
# Set to 0.0.0.0 to allow LAN devices; restrict the port to your private LAN in the firewall.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5177

# Optional: protects the local dashboard. Leave empty for no login.
DASHBOARD_PASSWORD=

# Community Core
DATABASE_PATH=./data/community-core.sqlite
DEFAULT_COMMUNITY_PROFILE=webradio
BOT_NAME=WebRadio Community
BOT_DESCRIPTION=Community Core Bot
# AI: none | ollama | openai-compatible
# Ollama kann lokal oder auf einem NAS/AI-Server im LAN laufen.
AI_PROVIDER=none
# Beispiele: http://127.0.0.1:11434 oder http://192.168.178.50:11434
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=
AI_API_KEY=

# Optional Discord identity sync
SYNC_BOT_USERNAME=false

